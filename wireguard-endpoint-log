#!/bin/sh

. /lib/functions.sh

INTERVAL="${1:-2}"
IP_ONLY="${2:-1}"
LOG="$3"
ASN="${4:-1}"
GEOIP="${5:-1}"
[ $# -ge 5 ] && shift 5 || set --
PREV=/tmp/wireguard-endpoint-log.prev
CUR=/tmp/wireguard-endpoint-log.cur
NOMOUNT=/tmp/wireguard-endpoint-log.nomount
GEO_CACHE=/tmp/wireguard-endpoint-log.geo
GEO_FAIL=/tmp/wireguard-endpoint-log.geofail
GEO_TTL=86400
GEO_MAX=500
GEO_BACKOFF=60

case "$INTERVAL" in
	''|*[!0-9]*|0) INTERVAL=2 ;;
esac
[ "$ASN" = 1 ] || ASN=0
[ "$GEOIP" = 1 ] || GEOIP=0

# Use the router's configured timezone (OpenWrt writes it to /etc/TZ).
[ -z "$TZ" ] && [ -r /etc/TZ ] && TZ=$(cat /etc/TZ) && export TZ

# Find the longest enabled fstab mount target that contains LOGDIR.
find_mount() {
	local enabled target
	config_get_bool enabled "$1" enabled 1
	[ "$enabled" = 1 ] || return
	config_get target "$1" target
	target=${target%/}
	[ -n "$target" ] || return
	case "$LOGDIR/" in
		"$target"/*) [ ${#target} -gt ${#MNT} ] && MNT=$target ;;
	esac
}

case "$LOG" in
	*/|*//*|*/./*|*/../*|*/.|*/..|[!/]*)
		logger -t wireguard-endpoint-log -p daemon.err "invalid log_file '$LOG', using syslog only"
		LOG='' ;;
esac

MNT=''
if [ -n "$LOG" ]; then
	LOGDIR=$(dirname "$LOG")
	config_load fstab
	config_foreach find_mount mount
fi
rm -f "$NOMOUNT"

# Copy to LOG unless it lives under an fstab mount that is not mounted,
# so writes never land in the bare mount point on the underlying filesystem.
log_file() {
	[ -n "$LOG" ] || return
	if [ -n "$MNT" ] &&
		! awk -v m="$MNT" '$2 == m { f = 1 } END { exit !f }' /proc/mounts; then
		[ -e "$NOMOUNT" ] && return
		: > "$NOMOUNT"
		logger -t wireguard-endpoint-log -p daemon.warn "$MNT not mounted, skipping log_file"
		return
	fi
	rm -f "$NOMOUNT"
	mkdir -p "$LOGDIR"
	echo "$(date '+%Y%m%d-%H:%M:%S') $*" >> "$LOG"
}

log() {
	logger -t wireguard-endpoint-log -p daemon.info "$*"
	log_file "$*"
}

# valid_cidr <a.b.c.d[/n]>: dotted-quad IPv4 with optional 0-32 prefix,
# no leading zeros (010 is octal to some tools, decimal to us)
valid_cidr() {
	printf '%s\n' "$1" | awk -F/ '
		NF > 2 { exit 1 }
		NF == 2 && ($2 !~ /^(0|[1-9][0-9]?)$/ || $2 + 0 > 32) { exit 1 }
		{
			if (split($1, o, ".") != 4) exit 1
			for (i = 1; i <= 4; i++)
				if (o[i] !~ /^(0|[1-9][0-9]?[0-9]?)$/ || o[i] + 0 > 255) exit 1
		}
		END { exit NR != 1 }'
}

IGNORE=''
for c in "$@"; do
	if valid_cidr "$c"; then
		IGNORE="${IGNORE:+$IGNORE }$c"
		case "$c" in
			*/0) logger -t wireguard-endpoint-log -p daemon.warn "ignore_cidr '$c' ignores every IPv4 endpoint" ;;
		esac
	else
		logger -t wireguard-endpoint-log -p daemon.err "invalid ignore_cidr '$c', skipping it"
	fi
done

command -v wg >/dev/null 2>&1 || { log "error: wg not found, exiting"; exit 1; }

if [ "$ASN" = 1 ] || [ "$GEOIP" = 1 ]; then
	for t in uclient-fetch jsonfilter; do
		command -v "$t" >/dev/null 2>&1 && continue
		logger -t wireguard-endpoint-log -p daemon.err "$t not found, disabling asn and geoip"
		ASN=0
		GEOIP=0
		break
	done
fi

# Keep state across restarts; it only resets when /tmp does (reboot).
[ -f "$PREV" ] || : > "$PREV"
# ip_only used to keep IPv6 brackets; drop them so upgraded state still matches
[ "$IP_ONLY" = 1 ] && sed -i 's/ \[\([^]]*\)\]$/ \1/' "$PREV"
log "started interval=${INTERVAL}s ip_only=$IP_ONLY asn=$ASN geoip=$GEOIP${IGNORE:+ ignore=$IGNORE}"

match_peer() {
	local key
	[ -n "$found" ] && return
	config_get key "$1" public_key
	[ "$key" = "$2" ] || return
	found=1
	config_get name "$1" description
}

# peer_name <iface> <pubkey>: description of the matching wireguard_<iface> section
peer_name() {
	local found='' name=''
	config_load network
	config_foreach match_peer "wireguard_$1" "$2"
	echo "$name"
}

# geo_key <ip>: cache key for a public unicast address (IPv4 as is, IPv6 as
# its /64); prints nothing for private, reserved or malformed addresses
geo_key() {
	printf '%s\n' "$1" | awk '
		NR > 1 { exit }
		{ a = tolower($0) }
		a ~ /^[0-9.]+$/ {
			if (split(a, o, ".") != 4) exit
			for (i = 1; i <= 4; i++)
				if (o[i] !~ /^(0|[1-9][0-9]?[0-9]?)$/ || o[i] + 0 > 255) exit
			x = o[1] + 0; y = o[2] + 0
			if (x == 0 || x == 10 || x == 127 || x >= 224) exit
			if (x == 100 && y >= 64 && y < 128) exit
			if (x == 169 && y == 254) exit
			if (x == 172 && y >= 16 && y < 32) exit
			if (x == 192 && y == 168) exit
			if (x == 192 && y == 0 && o[3] == "0") exit
			if (x == 198 && (y == 18 || y == 19)) exit
			print a
			exit
		}
		a !~ /^[0-9a-f:]+$/ || a !~ /:/ { exit }
		{
			n = split(a, h, "::")
			if (n > 2) exit
			nl = h[1] == "" ? 0 : split(h[1], l, ":")
			nr = (n == 2 && h[2] != "") ? split(h[2], r, ":") : 0
			if (n == 1 && nl != 8) exit
			if (n == 2 && nl + nr > 7) exit
			k = 0
			for (i = 1; i <= nl; i++) g[++k] = l[i]
			if (n == 2) for (i = nl + nr; i < 8; i++) g[++k] = "0"
			for (i = 1; i <= nr; i++) g[++k] = r[i]
			for (i = 1; i <= 8; i++)
				if (g[i] !~ /^[0-9a-f]+$/ || length(g[i]) > 4) exit
			# global unicast 2000::/3 only
			if (length(g[1]) != 4 || g[1] !~ /^[23]/) exit
			key = ""
			for (i = 1; i <= 4; i++) {
				x = g[i]
				sub(/^0+/, "", x)
				key = key (i > 1 ? ":" : "") (x == "" ? "0" : x)
			}
			print key "::/64"
		}'
}

# geo_fetch <ip> <key> <now>: query ipinfo.io and print a cache line
# "key time asn isp country city" ("-" for empty), also storing it in
# GEO_CACHE; fails quietly while backing off after an earlier failure
geo_fetch() {
	local until json line
	until=$(cat "$GEO_FAIL" 2>/dev/null)
	case "$until" in
		''|*[!0-9]*) ;;
		*) [ "$3" -lt "$until" ] && [ "$until" -le $(($3 + GEO_BACKOFF)) ] && return 1 ;;
	esac
	if json=$(uclient-fetch -q -T 3 -O - "https://ipinfo.io/$1/json" 2>/dev/null) &&
		[ -n "$(jsonfilter -s "$json" -e '@.ip' 2>/dev/null)" ]; then
		if [ -e "$GEO_FAIL" ]; then
			rm -f "$GEO_FAIL"
			logger -t wireguard-endpoint-log -p daemon.info "ipinfo.io lookups working again"
		fi
	else
		[ -e "$GEO_FAIL" ] ||
			logger -t wireguard-endpoint-log -p daemon.warn "ipinfo.io lookup failed (no network, HTTPS or rate limited), retrying every ${GEO_BACKOFF}s"
		echo $(($3 + GEO_BACKOFF)) > "$GEO_FAIL"
		return 1
	fi
	line=$(GEO_ORG=$(jsonfilter -s "$json" -e '@.org' 2>/dev/null) \
		GEO_CITY=$(jsonfilter -s "$json" -e '@.city' 2>/dev/null) \
		GEO_REGION=$(jsonfilter -s "$json" -e '@.region' 2>/dev/null) \
		GEO_COUNTRY=$(jsonfilter -s "$json" -e '@.country' 2>/dev/null) \
		awk -v k="$2" -v t="$3" '
		# clean <s>: drop whitespace and control characters, cap the length
		function clean(s) {
			gsub(/[[:space:][:cntrl:]=]/, "", s)
			s = substr(s, 1, 64)
			return s == "" ? "-" : s
		}
		BEGIN {
			org = ENVIRON["GEO_ORG"]
			asn = ""
			if (match(org, /^AS[0-9]+( |$)/)) {
				asn = substr(org, 1, RLENGTH)
				org = substr(org, RLENGTH + 1)
			}
			for (i = 0; i < 3; i++) {
				if (!match(tolower(org), /[ ,]+(inc|llc|l\.l\.c|ltd|limited|corp|corporation|co)\.?$/)) break
				org = substr(org, 1, RSTART - 1)
			}
			city = ENVIRON["GEO_CITY"]
			region = ENVIRON["GEO_REGION"]
			if (city != "" && region != "" && region != city) city = city "," region
			print k, t, clean(asn), clean(org), clean(ENVIRON["GEO_COUNTRY"]), clean(city)
		}')
	case "$line" in
		*"
"*) return 1 ;;
	esac
	set -f
	set -- $line
	set +f
	[ $# -eq 6 ] || return 1
	{
		awk -v k="$1" '$1 != k' "$GEO_CACHE" 2>/dev/null
		echo "$line"
	} | tail -n "$GEO_MAX" > "$GEO_CACHE.tmp" && mv "$GEO_CACHE.tmp" "$GEO_CACHE"
	echo "$line"
}

# geo_lookup <endpoint>: cache line for a public endpoint (cached, freshly
# fetched or stale), nothing if the address is not public or the lookup failed
geo_lookup() {
	local ip key now line stale=''
	case "$1" in
		\[*) ip=${1#\[}; ip=${ip%%\]*} ;;
		*:*:*) ip=$1 ;;
		*) ip=${1%:*} ;;
	esac
	key=$(geo_key "$ip")
	[ -n "$key" ] || return
	now=$(date +%s)
	line=$(awk -v k="$key" '$1 == k && NF == 6 && $2 ~ /^[1-9][0-9]*$/ && length($2) <= 10 { print; exit }' "$GEO_CACHE" 2>/dev/null)
	set -f
	set -- $line
	set +f
	if [ $# -eq 0 ] || [ "$2" -gt "$now" ] || [ $((now - $2)) -ge "$GEO_TTL" ]; then
		stale=$line
		line=$(geo_fetch "$ip" "$key" "$now") || line=$stale
		set -f
		set -- $line
		set +f
	fi
	[ $# -eq 6 ] || return
	echo "$line"
}

# geo_fields <endpoint>: " City=... Country=... ISP=... ASN=..." for the
# enabled options; unknown values are left blank so columns stay aligned
geo_fields() {
	local line asn='' isp='' country='' city=''
	line=$(geo_lookup "$1")
	set -f
	set -- $line
	set +f
	if [ $# -eq 6 ]; then
		[ "$3" = - ] || asn=$3
		[ "$4" = - ] || isp=$4
		[ "$5" = - ] || country=$5
		[ "$6" = - ] || city=$6
	fi
	[ "$GEOIP" = 1 ] && printf ' City=%s Country=%s ISP=%s' "$city" "$country" "$isp"
	[ "$ASN" = 1 ] && printf ' ASN=%s' "$asn"
	return 0
}

while :; do
	wg show all endpoints 2>/dev/null |
		awk -v iponly="$IP_ONLY" -v ignore="$IGNORE" '
			function ip2n(a,  o) {
				split(a, o, ".")
				return ((o[1] * 256 + o[2]) * 256 + o[3]) * 256 + o[4]
			}
			# ignored <endpoint>: 1 if an IPv4 endpoint falls in an ignore_cidr range
			function ignored(ep,  ip, x, i) {
				ip = ep
				sub(/:[0-9]+$/, "", ip)
				if (ip !~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/) return 0
				x = ip2n(ip)
				for (i = 1; i <= n; i++)
					if (int(x / size[i]) == net[i]) return 1
				return 0
			}
			BEGIN {
				n = split(ignore, c, " ")
				for (i = 1; i <= n; i++) {
					split(c[i], p, "/")
					size[i] = 2 ^ (32 - (p[2] == "" ? 32 : p[2]))
					net[i] = int(ip2n(p[1]) / size[i])
				}
			}
			$3 == "(none)" || ignored($3) { next }
			{
				if (iponly == "1") {
					sub(/:[0-9]+$/, "", $3)
					sub(/^\[/, "", $3)
					sub(/\]$/, "", $3)
				}
				print $1, $2, $3
			}
		' | sort -u > "$CUR"

	awk 'FILENAME == ARGV[1] { seen[$0] = 1; next } !($0 in seen)' "$PREV" "$CUR" |
	while read -r iface pub ep; do
		name=$(peer_name "$iface" "$pub")
		geo=''
		[ "$ASN" = 1 ] || [ "$GEOIP" = 1 ] && geo=$(geo_fields "$ep")
		log "iface=$iface peer=${name:-unnamed}$geo endpoint=$ep pubkey=$pub"
	done

	mv "$CUR" "$PREV"
	sleep "$INTERVAL"
done
