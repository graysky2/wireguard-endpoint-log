#!/bin/sh /etc/rc.common
# procd init script for wireguard-endpoint-log

START=99
STOP=10
USE_PROCD=1

validate_section() {
	uci_load_validate wireguard-endpoint-log main "$1" "$2" \
		'enabled:bool:1' \
		'interval:and(uinteger,range(1,86400)):2' \
		'ip_only:bool:1' \
		'asn:bool:1' \
		'geoip:bool:1' \
		'log_file:string' \
		'ignore_cidr:list(string)'
}

start_instance() {
	[ "$2" = 0 ] || {
		echo "validation failed" >&2
		return 1
	}

	[ "$enabled" = 1 ] || return 0

	procd_open_instance
	set -f
	procd_set_param command /usr/sbin/wireguard-endpoint-log "$interval" "$ip_only" "$log_file" "$asn" "$geoip" $ignore_cidr
	set +f
	[ -n "$log_file" ] && procd_set_param file /etc/config/fstab
	procd_set_param stderr 1
	procd_set_param respawn
	procd_close_instance
}

start_service() {
	validate_section main start_instance
}

service_triggers() {
	procd_add_reload_trigger wireguard-endpoint-log fstab
	procd_add_validation validate_section
}
